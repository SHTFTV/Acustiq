{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/products", "destination": "/product-knowledge", "permanent": true },
    { "source": "/for-matt", "destination": "/product-knowledge", "permanent": true },
    { "source": "/guest-post", "destination": "/product-knowledge", "permanent": true },
    { "source": "/locations/:slug*", "destination": "/installers/:slug*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
